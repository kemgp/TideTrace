# Leave empty locally to use Vite's /api proxy.
# In Vercel set the HTTPS Render origin, without /api. Rebuild after changing it.
VITE_API_URL=

# Optional Google Maps pin picker. The browser key is public; restrict it in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
# Testing only; replace with your own map ID for production.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
