# Copy to server/.env. No service-role or secret key is needed. 
HOST=127.0.0.1 PORT=3001 
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173 
SUPABASE_URL=https://YOUR_PROJECT.supabase.co 
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Direct local connections: 0. Render's immediate reverse proxy: 1.
# Reassess this value if adding another proxy; never trust all forwarded headers.
TRUST_PROXY_HOPS=0
